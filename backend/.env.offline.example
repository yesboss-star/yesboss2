# ============================================================
# YesBoss - LOCAL / OFFLINE test settings (isolated from production)
#
#   cp .env.offline.example .env.offline        (PowerShell: Copy-Item)
#   ENV_FILE=.env.offline  -> the backend reads THIS file instead of .env
#
# Nothing here points at production: local Mongo, no SMTP, no Zoho/Google/Cliq,
# no Qdrant/Supabase, scheduler OFF. Sign-in still uses Firebase (needs internet).
# ============================================================
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Local database (see docker run command in the steps). NOT the Atlas cluster.
MONGODB_URI=mongodb://127.0.0.1:27017/yesboss_local

# Never run the background jobs against a test database by accident.
SCHEDULER_ENABLED=false

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
API_URL=http://127.0.0.1:8000/api/v1
ADMIN_API_KEY=local-admin-key

# --- Firebase: token verification for sign-in (the only online dependency) -------------
# READ_ONLY: this run shares the real Firebase project, so it must never change real users
# (role claims, phone numbers, deletions). Sign-in and token checks still work.
FIREBASE_READ_ONLY=true
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# --- Email: blank = nothing is ever sent (OTP codes are returned/logged in development) --
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# --- Integrations OFF ----------------------------------------------------------------
ZOHO_CLIENT_ID=offline
ZOHO_CLIENT_SECRET=offline
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZOHO_CLIQ_ENABLED=false
STT_PROVIDER=none

# --- Optional services OFF (the app logs a warning and carries on) ---------------------
QDRANT_URL=
SUPABASE_URL=
SUPABASE_KEY=
REDIS_URL=

# --- AI: leave empty to run without LLM features, or paste your own key to try them ----
DEFAULT_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
