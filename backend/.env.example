# YesBoss API - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# Server Configuration
# ============================================
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins. Use * for all (dev only)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================
# AI Provider — DeepSeek (Primary chat model)
# ============================================
# DeepSeek powers all chat/analysis/generation features.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Default AI provider used across all features
# Options: deepseek, xai, openai, anthropic, gemini, qwen
DEFAULT_AI_PROVIDER=deepseek

# xAI Grok (optional fallback chat provider — kept for switch-back)
XAI_API_KEY=xai-...
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3

# ============================================
# Embeddings — Gemini (semantic search into Qdrant)
# ============================================
# Gemini does real embeddings (DeepSeek/Grok cannot). `gemini-embedding-2`
# outputs 1536-dim vectors that match the existing Qdrant collections.
GEMINI_API_KEY=AQ.YourGeminiApiKey
EMBEDDINGS_PROVIDER=gemini

# ============================================
# Web Scraping
# ============================================
FIRECRAWL_API_KEY=fc-...

# ============================================
# Supabase (Auth + Backend)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ============================================
# MongoDB Atlas (Document Store)
# ============================================
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/yesboss?retryWrites=true&w=majority

# ============================================
# Qdrant Cloud (Vector Database)
# ============================================
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ============================================
# SMTP Email Configuration (for OTP, password reset, notifications)
# ============================================
# Use your SMTP provider (Gmail, Zoho, SendGrid, etc.)
# For Gmail: enable 2FA and generate an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=YesBoss <your-email@gmail.com>
SMTP_USE_TLS=true

# ============================================
# Zoho Integration (OAuth2)
# ============================================
ZOHO_CLIENT_ID=1000.XXXX...
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REDIRECT_URI=http://localhost:8000/api/v1/zoho/callback
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_MAIL_API_URL=https://mail.zoho.com/api
ZOHO_CALENDAR_API_URL=https://calendar.zoho.com/api/v1

# ============================================
# Zoho Cliq Bot — Communication Agent (additive)
# ============================================
# Cliq must match the OAuth data center (accounts.zoho.com => cliq.zoho.com).
# ZOHO_CLIQ_BOT_ID is the bot UNIQUE NAME (slug), not the numeric b-... ID.
# TAZ webhook kept as fallback channel.
TAZ_WEBHOOK_URL=
ZOHO_CLIQ_API_BASE=https://cliq.zoho.com/api/v2
ZOHO_CLIQ_BOT_ID=
ZOHO_CLIQ_ORG_ID=
ZOHO_CLIQ_VERIFY_TOKEN=
ZOHO_CLIQ_ENABLED=true
# Optional staged-rollout allowlist (comma-separated emails). Empty = all recipients.
# When set, only listed users receive Cliq DMs and only their threads are followed up.
ZOHO_CLIQ_TEST_EMAILS=
# Cliq button-type Function name invoked by assignment cards (Started/Blocked/Extension).
ZOHO_CLIQ_BUTTON_FUNCTION=yesboss_task_action
# Optional server-side speech-to-text: none | whisper (OPENAI_API_KEY) | gemini (GEMINI_API_KEY).
# Browser SpeechRecognition remains the default voice path; `none` makes /assistant/transcribe return 501.
STT_PROVIDER=none

# ============================================
# Google Integration (Gmail + Google Tasks + Google Calendar)
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback

# ============================================
# Redis (Optional - for caching/queues)
# ============================================
REDIS_URL=redis://localhost:6379/0